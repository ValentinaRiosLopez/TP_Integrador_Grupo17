<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title><%= titulo %></title>
    <link rel="stylesheet" href="/public/static/estilos/adminCommons.css" />
    <link rel="stylesheet" href="/public/static/estilos/adminDashboard.css" />
  </head>

  <script src="/public/static/js/dashboard.js" defer></script>
  <body class="admin-page">
    <header class="admin-header">
      <a href="/" class="admin-brand">
        <img src="/public/static/imagenes/logo.png" alt="Logo" />
        <span><%= titulo %></span>
      </a>

      <nav>
        <a href="/">Volver al inicio</a>
      </nav>
    </header>

    <main class="admin-main">
      
      <section id="gestion-productos">
         <div class="encabezado-productos">
          <h2>Listado de productos</h2>
            <button id="btn-agregar-producto" class="btn-primary"   onclick="window.location.href='/admin/productos/nuevo'">
              Agregar producto +
          </button>
        </div>
        <table id="tabla-productos">
          <thead>
            <tr>
              <th>ID</th>
              <th>Imagen</th>
              <th>Nombre</th>
              <th>Categoría</th>
              <th>Tipo</th>
              <th>Precio</th>
              <th>Estado</th>
              <th>Acciones</th>
            </tr>
          </thead>

          <tbody>
            <% productos.forEach((producto) => { %>
              <tr>
                <td><%= producto.id %></td>

                <td>
                  <% if (producto.imagen) { %>
                    <img
                      class="imagen-producto"
                      src="<%= producto.imagen %>"
                      alt="<%= producto.nombre %>"
                    />
                  <% } else { %>
                    Sin imagen
                  <% } %>
                </td>

                <td><%= producto.nombre %></td>
                <td><%= producto.categoria %></td>
                <td><%= producto.tipo %></td>

                <td>
                  $<%= Number(producto.precio).toLocaleString("es-AR") %>
                </td>

                <td>
                  <% if (producto.activo) { %>
                    <span class="estado-activo">Activo</span>
                  <% } else { %>
                    <span class="estado-inactivo">Inactivo</span>
                  <% } %>
                </td>
                <td>
                  <div class="btn-acciones">
                  <button
                    type="button"
                    class="btn-editar-producto"
                    data-id="<%= producto.id %>"
                  >
                            <img class="icono-boton" src="/public/static/iconos/modify.png" alt="logo modificar" />Editar
                  </button>
                  <% if (producto.activo) { %>
                  <button
                    type="button"
                    class="btn-eliminar-producto"
                    data-id="<%= producto.id %>"
                    data-nombre="<%= producto.nombre %>"
                  >
                    <img class="icono-boton" src="/public/static/iconos/delete.png" alt="logo eliminar" />Eliminar
                  </button>
                   <% } else { %>
                        <button
                          type="button"
                          class="btn-disponibilizar-producto"
                          data-id="<%= producto.id %>"
                          data-nombre="<%= producto.nombre %>"
                      >
                         <img class="icono-boton" src="/public/static/iconos/reactivate.png" alt="logo disponibilizar" /> Disponibilizar 
                      </button>

                    <% } %>
                    </td>
              </tr>
            <% }); %>
          </tbody>
        </table>

        <dialog id="modal-confirmacion">
        <h3 id="titulo-modal"></h3>
        <p id="mensaje-modal"></p>
        
          <div class="acciones-modal">
            <button type="button" id="btn-cancelar">
              Cancelar
            </button>
          
            <button type="button" id="btn-confirmar">
              Confirmar
            </button>
          </div>
        </dialog>

      </section>
    </main>
  </body>
</html>

