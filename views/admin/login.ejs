
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Login | Administración</title>

  <link rel="stylesheet" href="../../public/static/estilos/adminLogin.css" />
  <script src="/js/admin-login.js" defer></script>
</head>

<body class="admin-login-page">

  <header class="admin-header">
    <a href="/" class="admin-brand">
      <img src="/recursos/imagenes/logo.png" alt="Logo" />
      <span>Autoservicio de juegos</span>
    </a>

    <nav>
      <a href="/">Volver al inicio</a>
    </nav>
  </header>

  <main class="admin-login-main">

    <section class="login-card">

      <h1>Iniciar sesión</h1>
      <p>Ingresá tus credenciales de administrador</p>

      <form id="form-login">

        <div class="form-group">
          <label for="email">Correo electrónico</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="admin@ejemplo.com"
            autocomplete="username"
            required
          />
        </div>

        <div class="form-group">
          <label for="password">Contraseña</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Ingresá tu contraseña"
            autocomplete="current-password"
            required
          />
        </div>

        <p id="login-error" role="alert"></p>

        <button type="submit" class="btn-primary">
          Ingresar
        </button>

      </form>

      <div class="quick-access">
        <p>Acceso rápido para pruebas</p>

        <button type="button" id="btn-acceso-rapido">
          Autocompletar credenciales
        </button>
      </div>

    </section>

  </main>

  <footer class="admin-footer">
    <p>Trabajo Integrador - Programación III - Grupo 17</p>
    <p>Valentina Rios Lopez - Facundo Rodriguez Ventura</p>
  </footer>

</body>
</html>
