<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Alta de producto | Ludonáutica</title>

    <link rel="stylesheet" href="/public/static/estilos/adminCommons.css" />
    <link rel="stylesheet" href="/public/static/estilos/adminNewProduct.css" />
  </head>
  <script src="/public/static/js/newProduct.js" defer></script>
  <body class="admin-page">
    <header class="admin-header">
      <a href="/" class="admin-brand">
        <img src="/public/static/imagenes/logo.png" alt="Logo" />
        <span><%= titulo %></span>
      </a>

      <nav>
        <a href="/">Volver al inicio</a>

        <a href="/admin/dashboard">Volver al dashboard</a>
      </nav>
    </header>

    <main class="admin-main">
      <section id="alta-producto">
        <h2>
          <%= modo === "editar" ? "Modificar producto" : "Agregar nuevo producto" %>
        </h2>

        <form
          id="form-alta-producto"
          data-modo="<%= modo %>"
          data-id="<%= productoId ?? '' %>"
        >
          <div class="form-group">
            <label for="nombre">Nombre</label>
            <input
              type="text"
              id="nombre"
              name="nombre"
              maxlength="100"
              required
            />
          </div>

          <div class="form-group">
            <label for="descripcion">Descripción</label>
            <textarea
              id="descripcion"
              name="descripcion"
              maxlength="500"
              rows="4"
            ></textarea>
          </div>

          <div class="form-group">
            <label for="precio">Precio</label>
            <input
              type="number"
              id="precio"
              name="precio"
              min="0"
              step="0.01"
              required
            />
          </div>

          <div class="form-group">
            <label for="tipo">Tipo de producto</label>
            <select id="tipo" name="tipo" required>
              <option value="">Seleccionar tipo</option>
              <option value="juego">Juego de mesa</option>
              <option value="dado">Dado</option>
            </select>
          </div>

          <div class="form-group">
            <label for="imagen">Imagen del producto</label>

            <img
              id="vista-previa-imagen"
              alt="Vista previa del producto"
              hidden
            />

            <input
              type="file"
              id="imagen"
              name="imagen"
              accept="image/jpeg,image/png"
            />
          </div>

          <div class="acciones">
            <button type="submit" id="btn-guardar">
              <%= modo === "editar" ? "Modificar" : "Guardar producto" %>
            </button>
            <a href="/admin/dashboard">Cancelar</a>
          </div>
        </form>
      </section>
    </main>
  </body>
</html>
