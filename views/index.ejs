<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TP INTEGRADOR</title>
    <link
      rel="shortcut icon"
      href="../public/static/imagenes/logo.png"
      type="image/x-icon"
    />
    <link rel="stylesheet" href="../public/static/estilos/style.css" />
    <link rel="stylesheet" href="../public/static/estilos/index.css" />
  </head>
  <body>
    <%- include('../src/componentes/header') %>
    <main id="contenido">
      <% if (!cliente) { %>
        <div id="panel-ingreso">
          <h2>Bienvenido</h2>
          <div id="ingreso">
            <form action="/" method="POST">
              <div class="form-cliente">
              <label>Ingresá tu nombre: </label>
              <input placeholder="Tu nombre" type="text" id="txt-nombre" name="name" required>
              <button type="submit" id="btn-ingreso">Aceptar</button></div>
            </form>
            <a href="/admin/login" id="ingreso-admin">Soy Administrador</a>
          </div>
          
        </div>
      <% } else { %>
        <div id="panel-cliente">
          <h3>Hola <span id="nombre-cliente"><%= cliente.name %>!!!</span></h3>
          <form action="/salir" method="POST">
            <button type="submit" id="btn-salir">Salir</button>
          </form>
        </div>
        <div id="inicio">
          <section id="sobre-nosotros">
            <h3>Sobre Nosotros</h3>
            <p>
              Descripcion de la tienda.Lorem ipsum dolor sit amet consectetur
              adipiscing, elit venenatis eleifend facilisis sociis aliquam
              feugiat, metus placerat dignissim urna pellentesque.
            </p>
          </section>
          <div id="productos-destacados">
            <h2>Nuestros Productos</h2>
            <div id="productos">
              <div class="tarjeta-productos">
                <div id="imagen-producto">
                  <a href="/productos/juegos">
                    <img src="../public/static/imagenes/juegos-de-mesa.png" alt="juegos de mesa">
                  </a>
                </div>
                <h2><a href="/productos/juegos">Juegos de Mesa</a></h2>
              </div>

              <div class="tarjeta-productos">
                <div id="imagen-producto">
                  <a href="/productos/dados">
                    <img src="../public/static/imagenes/dados.png" alt="dados">
                  </a>
                </div>
                <h2><a href="/productos/dados">Dados</a></h2>
                
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </main>
    <%- include('../src/componentes/footer') %>
  </body>
</html>
