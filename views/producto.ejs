<div id="producto">
    <div id="imagen-producto">
        <img src="../public/imagenes/sin-imagen.jpg" alt="sin imagen">
    </div>
    <div id="texto-producto">
        <h3><%= producto.nombre %></h3>
        <p><%= producto.descripcion %></p>
        <p>$<%= producto.precio %></p>    
    </div>
    <div id="section-agregar">
        <form action="/carrito" method="POST" id="form-agregar">
            <input type="hidden" name="productoId" value="<%= producto.id %>">
            <div>
            <input type="number" name="cantidad" value="1" min="1" max="10">   
            </div>
            <button type="submit">Agregar al carrito</button>
        </form>
    </div>
</div>