<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TP INTEGRADOR</title>
    <link
      rel="shortcut icon"
      href="../public/imagenes/logo.png"
      type="image/x-icon"
    />
    <link rel="stylesheet" href="../public/estilos/productos.css" />
    <link rel="stylesheet" href="../public/estilos/style.css" />

  </head>
  <body>
    <%- include('./header') %>
    <main id="contenido">
      <h1 id="titulo-productos">Nuestros Productos</h1>

      <div id="lista-productos">
        <% if(productos && productos.length > 0) {%>
          <% productos.forEach(producto => { -%>
            <%- include('./producto', { producto }) %>
          <% }); -%>
        <% } else { %>

        <% } %> 
      </div>
    </main>
    <%- include('./footer') %>
  </body>
</html>
